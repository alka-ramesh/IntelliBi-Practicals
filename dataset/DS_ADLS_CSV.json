{
	"name": "DS_ADLS_CSV",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS_CSV",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"Sink_container": {
				"type": "string"
			},
			"Sink_folder": {
				"type": "string"
			},
			"Sink_file": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(formatDateTime(utcNow(),'yyyy/MM/dd'),'/',dataset().Sink_file)",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().Sink_folder",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().Sink_container",
					"type": "Expression"
				}
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}