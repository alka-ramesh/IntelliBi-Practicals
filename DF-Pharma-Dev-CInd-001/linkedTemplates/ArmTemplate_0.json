			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Pipeline to read the tables from SQL server and ingest it to ADLS in CSV format using Lookup activity. Lookup used to read the retrieve the data (5000 rows / 4mb only) ",
				"activities": [
					{
						"name": "ForEach1",
						"type": "ForEach",
						"dependsOn": [
							{
