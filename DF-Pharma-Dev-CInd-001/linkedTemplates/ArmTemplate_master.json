{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DF-Pharma-Dev-CInd-001"
		},
		"LS_ASQL_Pharma_RAW_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_ASQL_Pharma_RAW'"
		},
		"AKV_ADLSAccess_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://KV-Pharma-Dev-Cind-001.vault.azure.net/"
		},
		"LS_ADLS_Sales_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlspharmadevcindia001.dfs.core.windows.net"
		},
		"LS_ASQL_Pharma_RAW_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "myserver-dev.database.windows.net"
		},
		"LS_ASQL_Pharma_RAW_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ADF"
		},
		"LS_ASQL_Pharma_RAW_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "intelibi"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "DF-Pharma-Dev-CInd-001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ASQL_Pharma_RAW_password": {
						"value": "[parameters('LS_ASQL_Pharma_RAW_password')]"
					},
					"AKV_ADLSAccess_properties_typeProperties_baseUrl": {
						"value": "[parameters('AKV_ADLSAccess_properties_typeProperties_baseUrl')]"
					},
					"LS_ASQL_Pharma_RAW_properties_typeProperties_server": {
						"value": "[parameters('LS_ASQL_Pharma_RAW_properties_typeProperties_server')]"
					},
					"LS_ASQL_Pharma_RAW_properties_typeProperties_database": {
						"value": "[parameters('LS_ASQL_Pharma_RAW_properties_typeProperties_database')]"
					},
					"LS_ASQL_Pharma_RAW_properties_typeProperties_userName": {
						"value": "[parameters('LS_ASQL_Pharma_RAW_properties_typeProperties_userName')]"
					},
					"LS_ADLS_Sales_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Sales_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}