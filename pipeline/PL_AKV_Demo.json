						"parameters": {
							"schema": "SalesLT",
							"Table": "Customer"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_KV",
						"type": "DatasetReference"
					}
				]
			}
		],
		"folder": {
